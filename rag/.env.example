# Runtime-in-Space RAG — Environment Variables
# Copy this file to .env and edit as needed.

# Paths (defaults are relative to the rag/ folder)
# RAG_DATA_DIR=../data
# RAG_CHROMA_DIR=./chroma_db
# RAG_CHUNKS_FILE=./chunks.jsonl
# RAG_SECTIONS_FILE=./sections.json

# Chunking
# RAG_CHUNK_SIZE=1400
# RAG_CHUNK_OVERLAP=200
# RAG_MIN_CHUNK_WORDS=10

# Embedding
# RAG_EMBEDDER_MODEL=BAAI/bge-base-en-v1.5
# RAG_EMBEDDER_DIMS=768
# RAG_EMBEDDER_MAX_SEQ=512
# RAG_EMBED_BATCH_SIZE=16

# ChromaDB
# RAG_COLLECTION_NAME=runtime_in_space

# Retrieval
# RAG_TOP_K=5
# RAG_SEMANTIC_WEIGHT=0.65
# RAG_HYBRID_POOL=20

# Generation: "ollama" (default, local) or "openai" (ChatGPT API, or any
# OpenAI-compatible endpoint). Switching provider needs no code change.
# RAG_LLM_PROVIDER=ollama

# Ollama -- set RAG_OLLAMA_MODEL to whichever local model you've pulled
# (qwen2.5:7b, llama3.1:8b, mistral:7b, ...).
# RAG_OLLAMA_MODEL=qwen2.5:7b
# RAG_OLLAMA_URL=http://localhost:11434/api/chat

# OpenAI / ChatGPT -- put your token in RAG_OPENAI_API_KEY. Never commit it.
# RAG_OPENAI_MODEL=gpt-4o-mini
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_API_KEY=

# RAG_LLM_TEMPERATURE=0
# RAG_LLM_NUM_CTX=4096
# RAG_LLM_TIMEOUT=300

