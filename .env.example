# Copy to .env (docker-compose reads it) or export in your shell.

# Assistant service: "mock" needs no key. "openai_compatible" works with any
# OpenAI-style endpoint, including a local Ollama (http://localhost:11434/v1).
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Forecast service: "linear" is the built-in baseline, "chronos" needs extra packages.
FORECAST_MODEL=linear
